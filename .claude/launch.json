{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && uv run uvicorn app.main:app --port 8000 --timeout-graceful-shutdown 3"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
