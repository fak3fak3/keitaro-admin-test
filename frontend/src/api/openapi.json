{"openapi": "3.1.0", "info": {"title": "Keitaro wrapper", "version": "0.1.0"}, "paths": {"/api/health": {"get": {"tags": ["health"], "summary": "Health", "operationId": "health_api_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Health Api Health Get"}}}}}}}, "/api/campaigns": {"get": {"tags": ["campaigns"], "summary": "List Campaigns", "description": "\u041a\u0430\u043c\u043f\u0430\u043d\u0438\u0438, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0447\u0435\u0440\u0435\u0437 \u043e\u0431\u0451\u0440\u0442\u043a\u0443, \u043d\u043e\u0432\u044b\u0435 \u0441\u0432\u0435\u0440\u0445\u0443.", "operationId": "list_campaigns_api_campaigns_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/CampaignOut"}, "type": "array", "title": "Response List Campaigns Api Campaigns Get"}}}}}}, "post": {"tags": ["campaigns"], "summary": "Create Campaign", "operationId": "create_campaign_api_campaigns_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CampaignCreateRequest"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CampaignOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/campaigns/connect": {"post": {"tags": ["campaigns"], "summary": "Connect Campaign", "operationId": "connect_campaign_api_campaigns_connect_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CampaignConnectRequest"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CampaignOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/offers": {"get": {"tags": ["offers"], "summary": "Search Offers", "description": "\u0410\u0432\u0442\u043e\u043a\u043e\u043c\u043f\u043b\u0438\u0442 \u043e\u0444\u0444\u0435\u0440\u043e\u0432: \u043f\u043e\u0434\u0441\u0442\u0440\u043e\u043a\u0430 \u0432 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0438 (\u0431\u0435\u0437 \u0443\u0447\u0451\u0442\u0430 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430) \u0438\u043b\u0438 \u0432 id.", "operationId": "search_offers_api_offers_get", "parameters": [{"name": "q", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 100, "default": "", "title": "Q"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/OfferOut"}, "title": "Response Search Offers Api Offers Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/campaigns/{campaign_id}/fetch": {"post": {"tags": ["editor"], "summary": "Fetch Streams", "description": "Fetch streams from KT: \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u043f\u043e\u0442\u043e\u043a\u0438 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438 \u0438\u0437 Keitaro (\u0441\u043b\u0438\u044f\u043d\u0438\u0435 \u0441 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u043e\u043c).", "operationId": "fetch_streams_api_campaigns__campaign_id__fetch_post", "parameters": [{"name": "campaign_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Campaign Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/StreamOut"}, "title": "Response Fetch Streams Api Campaigns  Campaign Id  Fetch Post"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/campaigns/{campaign_id}/streams": {"get": {"tags": ["editor"], "summary": "List Streams", "description": "\u041f\u043e\u0442\u043e\u043a\u0438 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438 \u0432 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0435 (\u0438\u0437 \u043d\u0430\u0448\u0435\u0439 \u0411\u0414). \u041f\u0443\u0441\u0442\u043e \u2014 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u044e \u0435\u0449\u0451 \u043d\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u043b\u0438 (Fetch).", "operationId": "list_streams_api_campaigns__campaign_id__streams_get", "parameters": [{"name": "campaign_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Campaign Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/StreamOut"}, "title": "Response List Streams Api Campaigns  Campaign Id  Streams Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/offers": {"post": {"tags": ["editor"], "summary": "Add Offer", "description": "Add: \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043e\u0444\u0444\u0435\u0440 \u0432 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u043f\u043e\u0442\u043e\u043a\u0430, \u0434\u043e\u043b\u0438 \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f.", "operationId": "add_offer_api_streams__stream_id__offers_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddOfferIn"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/offers/{offer_id}/remove": {"post": {"tags": ["editor"], "summary": "Remove Offer", "description": "Remove: \u043e\u0444\u0444\u0435\u0440 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0432 \u043f\u043e\u0442\u043e\u043a\u0435 \u0441\u0435\u0440\u044b\u043c (removed, 0%), \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f.", "operationId": "remove_offer_api_streams__stream_id__offers__offer_id__remove_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}, {"name": "offer_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Offer Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/offers/{offer_id}/bring-back": {"post": {"tags": ["editor"], "summary": "Bring Back", "description": "Bring back: \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u0443\u0434\u0430\u043b\u0451\u043d\u043d\u044b\u0439 \u043e\u0444\u0444\u0435\u0440.", "operationId": "bring_back_api_streams__stream_id__offers__offer_id__bring_back_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}, {"name": "offer_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Offer Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/offers/{offer_id}/pin": {"post": {"tags": ["editor"], "summary": "Pin", "description": "\u0417\u0430\u043a\u0440\u0435\u043f\u0438\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0443\u044e \u0434\u043e\u043b\u044e \u043e\u0444\u0444\u0435\u0440\u0430.", "operationId": "pin_api_streams__stream_id__offers__offer_id__pin_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}, {"name": "offer_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Offer Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/offers/{offer_id}/unpin": {"post": {"tags": ["editor"], "summary": "Unpin", "description": "\u0421\u043d\u044f\u0442\u044c \u043f\u0438\u043d: \u0434\u043e\u043b\u044f \u0441\u043d\u043e\u0432\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438.", "operationId": "unpin_api_streams__stream_id__offers__offer_id__unpin_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}, {"name": "offer_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Offer Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/offers/{offer_id}/share": {"put": {"tags": ["editor"], "summary": "Set Share", "description": "\u0417\u0430\u0434\u0430\u0442\u044c \u0434\u043e\u043b\u044e \u0432\u0440\u0443\u0447\u043d\u0443\u044e: \u043e\u043d\u0430 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u044f\u0435\u0442\u0441\u044f, \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f (DISPUTED.md \u21161).", "operationId": "set_share_api_streams__stream_id__offers__offer_id__share_put", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}, {"name": "offer_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Offer Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ShareIn"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/push": {"post": {"tags": ["editor"], "summary": "Push", "description": "Push to KT: \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a. 409 \u2014 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044b \u043d\u0435 \u0440\u0435\u0448\u0435\u043d\u044b \u0438\u043b\u0438 Keitaro \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0441\u044f.", "operationId": "push_api_streams__stream_id__push_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/cancel": {"post": {"tags": ["editor"], "summary": "Cancel", "description": "Cancel: \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a, \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435.", "operationId": "cancel_api_streams__stream_id__cancel_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/offers/{offer_id}/resolve": {"post": {"tags": ["editor"], "summary": "Resolve", "description": "\u0420\u0435\u0448\u0438\u0442\u044c \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0444\u0444\u0435\u0440\u0430 \u0441 Keitaro (DISPUTED.md \u21168).", "operationId": "resolve_api_streams__stream_id__offers__offer_id__resolve_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}, {"name": "offer_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Offer Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResolveIn"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/resolve": {"post": {"tags": ["editor"], "summary": "Resolve All", "description": "\u0420\u0435\u0448\u0438\u0442\u044c \u0432\u0441\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044b \u043f\u043e\u0442\u043e\u043a\u0430 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e: \u00ab\u0432\u0441\u0451 \u043c\u043e\u0451\u00bb \u0438\u043b\u0438 \u00ab\u0432\u0441\u0451 \u0438\u0437 Keitaro\u00bb.", "operationId": "resolve_all_api_streams__stream_id__resolve_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResolveIn"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/streams/{stream_id}/acknowledge": {"post": {"tags": ["editor"], "summary": "Acknowledge", "description": "\u00ab\u041f\u043e\u043d\u044f\u0442\u043d\u043e\u00bb: \u0441\u043d\u044f\u0442\u044c \u043f\u043e\u043c\u0435\u0442\u043a\u0438 \u043e\u0431 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u0445 \u0432 Keitaro. \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044b \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f.", "operationId": "acknowledge_api_streams__stream_id__acknowledge_post", "parameters": [{"name": "stream_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Stream Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StreamOut"}}}}, "422": {"des