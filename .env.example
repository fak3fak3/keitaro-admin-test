KEITARO_URL=https://tlgk.host
KEITARO_ADMIN_TOKEN=
# По умолчанию SQLite в файле app.db; для Postgres: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./app.db

# С какими доменом, группой кампаний и источником создаются кампании (ищутся в Keitaro по имени)
KEITARO_DOMAIN=kylovoa.com
KEITARO_GROUP=FORTESTS
KEITARO_TRAFFIC_SOURCE=FORTESTS
